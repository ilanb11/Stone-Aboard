# Copy to .env and restart `npm run dev` to put Lucas the Hog (and AI outreach rewrites) online.
# The key is read only by the dev server's /api routes and never sent to the browser.
ANTHROPIC_API_KEY=

# Real email for the demo (optional). Sent through Resend from the dev server, only to MAIL_TEST_TO,
# at most MAIL_MAX_SENDS emails (never more than 5; the count is kept in .mail-log.json).
# Sign up at resend.com with the same address as MAIL_TEST_TO: without a verified domain, Resend
# only delivers to that address. Leave RESEND_API_KEY empty and sending stays simulated.
RESEND_API_KEY=
MAIL_TEST_TO=
MAIL_MAX_SENDS=5
# On Vercel: also set MAIL_SEND_PASSCODE (the public site sends nothing without it), and use a
# Full access Resend key there (the function counts sent emails from Resend's history).
MAIL_SEND_PASSCODE=
